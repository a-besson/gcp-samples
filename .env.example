# Core Infrastructure Configuration
# This file centralizes configuration for all Terraform samples.
# Taskfiles read this file via 'dotenv', injecting variables directly into the build and deploy tasks.
# Variables prefixed with 'TF_VAR_' are automatically picked up by Terraform without requiring '-var' arguments.

# --- Global Settings ---
PROJECT_ID="project-xxx-xxxx-xxxx-xxxxx"
REGION="europe-west9"

# Terraform will automatically pick these up because of the TF_VAR_ prefix.
TF_VAR_project_id="project-xxx-xxxx-xxxx-xxxxx"
TF_VAR_region="europe-west9"

# --- Cloud Run Simple Service & Job ---
IMAGE_SERVICE="us-docker.pkg.dev/cloudrun/container/hello"
TF_VAR_image_service="us-docker.pkg.dev/cloudrun/container/hello"

# --- Cloud Run Bastion Config ---
DOMAIN="bastion.example.com"
IAP_USER_EMAIL="admin@example.com"
SUPPORT_EMAIL="admin@example.com"

TF_VAR_domain="bastion.example.com"
TF_VAR_iap_user_email="admin@example.com"
TF_VAR_support_email="admin@example.com"
