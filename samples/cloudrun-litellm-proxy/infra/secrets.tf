# LITELLM_MASTER_KEY: proxy admin key. Secret resource created here; value
# seeded out-of-band via `task seed-key` so it never touches Terraform state.
resource "google_secret_manager_secret" "master_key" {
  secret_id = "litellm-master-key${var.name_suffix}"
  project   = var.project_id

  replication {
    user_managed {
      replicas {
        location = var.region
      }
    }
  }
}

# DATABASE_URL: Postgres connection string for LiteLLM Virtual Keys backend.
# The password is generated by random_password (in cloudsql.tf) so a secret
# version is created here automatically — it lives in Terraform state alongside
# the password resource.
resource "google_secret_manager_secret" "database_url" {
  secret_id = "litellm-database-url${var.name_suffix}"
  project   = var.project_id

  replication {
    user_managed {
      replicas {
        location = var.region
      }
    }
  }
}

resource "google_secret_manager_secret_version" "database_url" {
  secret = google_secret_manager_secret.database_url.id
  # The Cloud SQL Auth Proxy sidecar listens on localhost:5432.
  secret_data = "postgresql://litellm:${random_password.db_password.result}@localhost:5432/litellm"

  depends_on = [module.cloudsql]
}
