        <mxCell id="flow-dns" value="custom domain" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4285F4;strokeWidth=1;dashed=1;fontSize=9;exitX=1;exitY=0;exitDx=0;exitDy=10;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev1" target="dns-icon">
